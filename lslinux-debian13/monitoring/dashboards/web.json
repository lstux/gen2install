{
 "uid": "lslng-web",
 "title": "lslng - Web (nginx par vhost)",
 "tags": [
  "lslng"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "1m",
 "time": {
  "from": "now-24h",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "row",
   "title": "Trafic par vhost",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   }
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Requetes par minute",
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "label_replace(sum by (logfile)(rate(weblog_requests_total{logfile=~\"$vhost\"}[5m]))*60,\"vhost\",\"$1\",\"logfile\",\".*/(.*)\\\\.access\\\\.log\")",
     "legendFormat": "{{vhost}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ]
  },
  {
   "id": 3,
   "type": "bargauge",
   "title": "Requetes sur la periode",
   "gridPos": {
    "x": 12,
    "y": 1,
    "w": 6,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "label_replace(sum by (logfile)(increase(weblog_requests_total{logfile=~\"$vhost\"}[$__range])),\"vhost\",\"$1\",\"logfile\",\".*/(.*)\\\\.access\\\\.log\")",
     "legendFormat": "{{vhost}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "instant": true
    }
   ]
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Trafic sortant",
   "gridPos": {
    "x": 18,
    "y": 1,
    "w": 6,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "Bps"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "label_replace(sum by (logfile)(rate(weblog_bytes_total{logfile=~\"$vhost\"}[5m])),\"vhost\",\"$1\",\"logfile\",\".*/(.*)\\\\.access\\\\.log\")",
     "legendFormat": "{{vhost}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ]
  },
  {
   "id": 5,
   "type": "row",
   "title": "Statuts et clients",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 9,
    "w": 24,
    "h": 1
   }
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Codes de reponse (par min)",
   "gridPos": {
    "x": 0,
    "y": 10,
    "w": 8,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (status)(rate(weblog_requests_total{logfile=~\"$vhost\"}[5m]))*60",
     "legendFormat": "{{status}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ]
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Erreurs 4xx / 5xx (par min)",
   "gridPos": {
    "x": 8,
    "y": 10,
    "w": 8,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(weblog_requests_total{logfile=~\"$vhost\",status=~\"4..\"}[5m]))*60",
     "legendFormat": "4xx",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    },
    {
     "refId": "B",
     "expr": "sum(rate(weblog_requests_total{logfile=~\"$vhost\",status=~\"5..\"}[5m]))*60",
     "legendFormat": "5xx",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ]
  },
  {
   "id": 8,
   "type": "bargauge",
   "title": "Type de clients (sur la periode)",
   "gridPos": {
    "x": 16,
    "y": 10,
    "w": 8,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (kind)(increase(weblog_clients_total{logfile=~\"$vhost\"}[$__range]))",
     "legendFormat": "{{kind}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "instant": true
    }
   ]
  },
  {
   "id": 9,
   "type": "row",
   "title": "Pages les plus demandees",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 18,
    "w": 24,
    "h": 1
   }
  },
  {
   "id": 10,
   "type": "bargauge",
   "title": "Top chemins (2xx/3xx, premier segment)",
   "gridPos": {
    "x": 0,
    "y": 19,
    "w": 12,
    "h": 10
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "topk(15, sum by (path)(increase(weblog_paths_total{logfile=~\"$vhost\"}[$__range])))",
     "legendFormat": "{{path}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "instant": true
    }
   ]
  },
  {
   "id": 11,
   "type": "bargauge",
   "title": "Methodes HTTP (sur la periode)",
   "gridPos": {
    "x": 12,
    "y": 19,
    "w": 12,
    "h": 10
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (method)(increase(weblog_requests_total{logfile=~\"$vhost\"}[$__range]))",
     "legendFormat": "{{method}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "instant": true
    }
   ]
  },
  {
   "id": 12,
   "type": "row",
   "title": "nginx (global)",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 29,
    "w": 24,
    "h": 1
   }
  },
  {
   "id": 13,
   "type": "timeseries",
   "title": "Connexions",
   "gridPos": {
    "x": 0,
    "y": 30,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "nginx_connections_active",
     "legendFormat": "actives",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    },
    {
     "refId": "B",
     "expr": "nginx_connections_reading",
     "legendFormat": "lecture",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    },
    {
     "refId": "C",
     "expr": "nginx_connections_writing",
     "legendFormat": "ecriture",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    },
    {
     "refId": "D",
     "expr": "nginx_connections_waiting",
     "legendFormat": "en attente",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ]
  },
  {
   "id": 14,
   "type": "timeseries",
   "title": "Connexions acceptees / requetes (par s)",
   "gridPos": {
    "x": 12,
    "y": 30,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "rate(nginx_connections_accepted[5m])",
     "legendFormat": "acceptees",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    },
    {
     "refId": "B",
     "expr": "rate(nginx_http_requests_total[5m])",
     "legendFormat": "requetes",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ]
  }
 ],
 "templating": {
  "list": [
   {
    "name": "vhost",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "query": {
     "query": "label_values(weblog_requests_total, logfile)",
     "refId": "v"
    },
    "definition": "label_values(weblog_requests_total, logfile)",
    "includeAll": true,
    "multi": true,
    "allValue": ".*",
    "current": {
     "text": "All",
     "value": "$__all"
    },
    "refresh": 2,
    "regex": ""
   }
  ]
 }
}