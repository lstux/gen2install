{
  "uid": "lslng-dmarc",
  "title": "lslng - DMARC",
  "tags": ["lslng"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1h",
  "time": {"from": "now-7d", "to": "now"},
  "templating": {"list": []},
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Taux DMARC pass (fenetre 7 j)",
      "gridPos": {"x": 0, "y": 0, "w": 8, "h": 6},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1,
        "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "orange", "value": 0.9}, {"color": "green", "value": 0.98}]}},
        "overrides": []},
      "targets": [{"refId": "A", "expr": "sum by (domain) (dmarc_messages{dmarc=\"pass\"}) / sum by (domain) (dmarc_messages)", "legendFormat": "{{domain}}", "datasource": {"type": "prometheus", "uid": "prometheus"}, "instant": true}]
    },
    {
      "id": 2, "type": "stat", "title": "Messages decrits par les rapports (fenetre 7 j)",
      "gridPos": {"x": 8, "y": 0, "w": 8, "h": 6},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "targets": [{"refId": "A", "expr": "sum by (domain) (dmarc_messages)", "legendFormat": "{{domain}}", "datasource": {"type": "prometheus", "uid": "prometheus"}, "instant": true}]
    },
    {
      "id": 3, "type": "stat", "title": "Age du dernier rapport",
      "gridPos": {"x": 16, "y": 0, "w": 8, "h": 6},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "dtdurations"}, "overrides": []},
      "targets": [{"refId": "A", "expr": "time() - max by (domain) (dmarc_last_report_timestamp_seconds)", "legendFormat": "{{domain}}", "datasource": {"type": "prometheus", "uid": "prometheus"}, "instant": true}]
    },
    {
      "id": 4, "type": "table", "title": "Messages par resultat (domaine, SPF, DKIM, politique)",
      "gridPos": {"x": 0, "y": 6, "w": 12, "h": 9},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {}, "overrides": []},
      "options": {"showHeader": true},
      "targets": [{"refId": "A", "expr": "sum by (domain, dkim, spf, disposition, dmarc) (dmarc_messages)", "format": "table", "instant": true, "datasource": {"type": "prometheus", "uid": "prometheus"}}]
    },
    {
      "id": 5, "type": "table", "title": "Rapports recus par organisation",
      "gridPos": {"x": 12, "y": 6, "w": 12, "h": 9},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {}, "overrides": []},
      "options": {"showHeader": true},
      "targets": [{"refId": "A", "expr": "dmarc_reports", "format": "table", "instant": true, "datasource": {"type": "prometheus", "uid": "prometheus"}}]
    },
    {
      "id": 6, "type": "table", "title": "Sources en echec DMARC (top 20)",
      "gridPos": {"x": 0, "y": 15, "w": 24, "h": 10},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {}, "overrides": []},
      "options": {"showHeader": true, "sortBy": [{"displayName": "Value", "desc": true}]},
      "targets": [{"refId": "A", "expr": "dmarc_failing_messages", "format": "table", "instant": true, "datasource": {"type": "prometheus", "uid": "prometheus"}}]
    },
    {
      "id": 7, "type": "stat", "title": "Parseur DMARC OK",
      "gridPos": {"x": 0, "y": 25, "w": 6, "h": 4},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "short", "mappings": [{"type": "value", "options": {"0": {"text": "ERREUR", "color": "red"}, "1": {"text": "OK", "color": "green"}}}]}, "overrides": []},
      "targets": [{"refId": "A", "expr": "dmarc_parse_ok", "datasource": {"type": "prometheus", "uid": "prometheus"}, "instant": true}]
    }
  ]
}
